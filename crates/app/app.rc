// Windows resources: icon, version info shown in Explorer and Task Manager,
// and the application manifest.

1 ICON "assets/icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "RAM Optimizer"
      VALUE "FileDescription", "RAM Optimizer"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "RAMOptimizer"
      VALUE "OriginalFilename", "RAMOptimizer.exe"
      VALUE "ProductName", "RAM Optimizer"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
