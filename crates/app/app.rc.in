// Windows resources: icon, version info shown in Explorer and Task Manager,
// and the application manifest. build.rs fills in the {{...}} placeholders.

1 ICON "{{ICON}}"
1 24 "{{MANIFEST}}"

1 VERSIONINFO
FILEVERSION {{VERSION_NUMBERS}}
PRODUCTVERSION {{VERSION_NUMBERS}}
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "RAM Optimizer"
      VALUE "FileDescription", "RAM Optimizer"
      VALUE "FileVersion", "{{VERSION}}"
      VALUE "InternalName", "RAMOptimizer"
      VALUE "OriginalFilename", "RAMOptimizer.exe"
      VALUE "ProductName", "RAM Optimizer"
      VALUE "ProductVersion", "{{VERSION}}"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
